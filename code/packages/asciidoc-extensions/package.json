{
  "name": "@inditextech/pdocs-asciidoc-extensions",
  "version": "0.1.0",
  "private": true,
  "description": "Asciidoctor extensions shared by pdocs documentation sites — authored content that has no AsciiDoc equivalent, rendered as IOP DS markup",
  "license": "MPL-2.0",
  "main": "index.js",
  "engines": {
    "node": ">=24.0.0"
  },
  "scripts": {
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix"
  },
  "devDependencies": {
    "@asciidoctor/core": "~4.0.8",
    "typescript": "6.0.3"
  },
  "dependencies": {
    "asciidoctor-core-2.2": "npm:@asciidoctor/core@~2.2",
    "shiki": "~4.4.0"
  }
}
