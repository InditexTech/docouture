{{!--
  The button carries its own accessible name: src/js/08-theme.ts sets aria-label
  and aria-pressed once it wires the control up, so the icons stay decorative.
--}}
<button class="dt-button dt-button--ghost dt-button--icon-only theme-toggle" type="button" hidden>
  <span class="dt-button__content">
    <span class="dt-button__icon dt-button__icon-icon theme-toggle-icon theme-toggle-icon--light" aria-hidden="true">{{icon "sun"}}</span>
    <span class="dt-button__icon dt-button__icon-icon theme-toggle-icon theme-toggle-icon--dark" aria-hidden="true">{{icon "moon"}}</span>
  </span>
</button>
