{{!--
  Preview-only layout (GH-66). Lives in preview-src/layouts, not src/layouts,
  so it is never packed into the published UI bundle — see icons.hbs for the
  same convention.

  Reviews the dialog's content states — idle, loading, results (with module
  chips), filtered results, recent searches, and empty — side by side. Each
  card renders `.dt-modal`/`.dt-modal__container` directly (not the real
  `<dialog>`): `search-dialog.hbs` (included on every real page via
  header.hbs) already carries the outer `<dialog>` + `.dt-overlay`, and
  `.dt-overlay` is `position: fixed` to the *viewport* — fine for one dialog
  on a real page, wrong for several shown at once here, which would stack
  full-page scrims. The panel is what actually differs per state, so that's
  what this page compares; the outer shell (positioning, the deliberate DS
  deviation in search-dialog.css, the backdrop) is reviewed live, per the
  issue's own acceptance criteria, by opening the real dialog from devtools
  on any page.

  Light/dark: this project has no in-preview theme toggle (head-prelude.hbs
  follows `prefers-color-scheme` with no override UI here) — switch with
  devtools' rendering emulation to review both.

  GH-68 (S4): the fullscreen variant and the xs-only floating trigger are
  breakpoint- and viewport-fixed-position concerns respectively — same
  reasoning as the paragraph above, both are reviewed live (devtools
  responsive mode) rather than faked into this static grid.

  GH-69 (S5): the module chips and recents rows below are static fixture
  markup, not rendered by 12-search.ts/13-search-recents.ts — this page has
  no search index and no localStorage state to drive them from. They mirror
  exactly what those files build at runtime (same classes, same structure)
  so the two states are still reviewable without a live component with
  several modules and a search history to hand.
--}}
<!DOCTYPE html>
<html lang="en">
  <head>
{{> head defaultPageTitle='Search Dialog States'}}
    <link rel="stylesheet" href="{{{siteRootPath}}}/preview.css">
  </head>
  <body class="search-dialog-page">
    <main class="search-dialog-preview">
      <a class="search-dialog-preview__back dt-text dt-text--body-m" href="{{{siteRootPath}}}/index.html">{{icon "arrow-left"}} UI Preview</a>
      <div class="search-dialog-preview__grid">

        <section class="search-dialog-preview__card">
          <h2 class="search-dialog-preview__title dt-text dt-text--title-s">Idle</h2>
          <div class="search-dialog-preview__panel dt-modal dt-modal--small">
            <div class="dt-modal__container">
              <div class="dt-search-field-minimal dt-search-field-minimal--full-width">
                <span class="dt-search-field-minimal__icon-start" aria-hidden="true">{{icon "search"}}</span>
                <div class="dt-search-field-minimal__input-wrapper">
                  <div class="dt-search-field-minimal__input-container">
                    <input type="search" class="dt-search-field-minimal__input" placeholder="Search the docs" readonly>
                  </div>
                </div>
              </div>
              <div class="dt-modal__content dt-modal__content--scrollable search-dialog__results"></div>
              <div class="dt-modal__footer dt-modal__footer--horizontal">
                <span class="dt-modal__footer-left dt-text dt-text--detail-m"><kbd>&uarr;&darr;</kbd> navigate &middot; <kbd>&crarr;</kbd> select &middot; <kbd>esc</kbd> close</span>
              </div>
            </div>
          </div>
        </section>

        <section class="search-dialog-preview__card">
          <h2 class="search-dialog-preview__title dt-text dt-text--title-s">Recent searches</h2>
          <div class="search-dialog-preview__panel dt-modal dt-modal--small">
            <div class="dt-modal__container">
              <div class="dt-search-field-minimal dt-search-field-minimal--full-width">
                <span class="dt-search-field-minimal__icon-start" aria-hidden="true">{{icon "search"}}</span>
                <div class="dt-search-field-minimal__input-wrapper">
                  <div class="dt-search-field-minimal__input-container">
                    <input type="search" class="dt-search-field-minimal__input" placeholder="Search the docs" readonly>
                  </div>
                </div>
              </div>
              <div class="dt-modal__content dt-modal__content--scrollable search-dialog__results">
                <p class="search-recents__heading">Recent searches</p>
                <ul class="dt-list">
                  <li class="dt-list-item dt-list-item--clickable search-recents__row">
                    <span class="dt-list-item__icon-start" aria-hidden="true">{{icon "rotate-ccw-clock"}}</span>
                    <span class="dt-list-item__text">
                      <span class="dt-list-item__label">event listener</span>
                    </span>
                    <span class="dt-list-item__content-end">
                      <button type="button" class="dt-button dt-button--ghost dt-button--icon-only" aria-label="Remove &ldquo;event listener&rdquo; from recent searches">
                        <span class="dt-button__content">
                          <span class="dt-button__icon dt-button__icon-icon">{{icon "x"}}</span>
                        </span>
                      </button>
                    </span>
                  </li>
                  <li class="dt-list-item dt-list-item--clickable search-recents__row">
                    <span class="dt-list-item__icon-start" aria-hidden="true">{{icon "rotate-ccw-clock"}}</span>
                    <span class="dt-list-item__text">
                      <span class="dt-list-item__label">getting started</span>
                    </span>
                    <span class="dt-list-item__content-end">
                      <button type="button" class="dt-button dt-button--ghost dt-button--icon-only" aria-label="Remove &ldquo;getting started&rdquo; from recent searches">
                        <span class="dt-button__content">
                          <span class="dt-button__icon dt-button__icon-icon">{{icon "x"}}</span>
                        </span>
                      </button>
                    </span>
                  </li>
                </ul>
              </div>
              <div class="dt-modal__footer dt-modal__footer--horizontal">
                <span class="dt-modal__footer-left dt-text dt-text--detail-m"><kbd>&uarr;&darr;</kbd> navigate &middot; <kbd>&crarr;</kbd> select &middot; <kbd>esc</kbd> close</span>
              </div>
            </div>
          </div>
        </section>

        <section class="search-dialog-preview__card">
          <h2 class="search-dialog-preview__title dt-text dt-text--title-s">Loading</h2>
          <div class="search-dialog-preview__panel dt-modal dt-modal--small">
            <div class="dt-modal__container">
              <div class="dt-search-field-minimal dt-search-field-minimal--full-width dt-search-field-minimal--has-value dt-search-field-minimal--focused">
                <span class="dt-search-field-minimal__icon-start" aria-hidden="true">{{icon "search"}}</span>
                <div class="dt-search-field-minimal__input-wrapper">
                  <div class="dt-search-field-minimal__input-container">
                    <input type="search" class="dt-search-field-minimal__input" value="weave" readonly>
                  </div>
                </div>
              </div>
              <div class="dt-modal__content dt-modal__content--scrollable search-dialog__results">
                <div class="dt-loader" aria-hidden="true">
                  <span class="dt-loader__circle dt-loader__circle--medium"><span></span></span>
                  <span class="dt-loader__label">Loading the search index&hellip;</span>
                </div>
              </div>
              <div class="dt-modal__footer dt-modal__footer--horizontal">
                <span class="dt-modal__footer-left dt-text dt-text--detail-m"><kbd>&uarr;&darr;</kbd> navigate &middot; <kbd>&crarr;</kbd> select &middot; <kbd>esc</kbd> close</span>
              </div>
            </div>
          </div>
        </section>

        <section class="search-dialog-preview__card">
          <h2 class="search-dialog-preview__title dt-text dt-text--title-s">Results (module chips, All)</h2>
          <div class="search-dialog-preview__panel dt-modal dt-modal--small">
            <div class="dt-modal__container">
              <div class="dt-search-field-minimal dt-search-field-minimal--full-width dt-search-field-minimal--has-value dt-search-field-minimal--focused">
                <span class="dt-search-field-minimal__icon-start" aria-hidden="true">{{icon "search"}}</span>
                <div class="dt-search-field-minimal__input-wrapper">
                  <div class="dt-search-field-minimal__input-container">
                    <input type="search" class="dt-search-field-minimal__input" value="event" readonly>
                  </div>
                </div>
              </div>
              <div class="search-dialog__chips" role="group" aria-label="Filter results by module">
                <button type="button" class="dt-tag dt-tag--solid dt-tag--selected search-dialog__chip" aria-pressed="true">
                  <span class="dt-tag__label">All</span>
                </button>
                <button type="button" class="dt-tag dt-tag--solid search-dialog__chip" aria-pressed="false">
                  <span class="dt-tag__label">SDK</span>
                </button>
                <button type="button" class="dt-tag dt-tag--solid search-dialog__chip" aria-pressed="false">
                  <span class="dt-tag__label">Guides</span>
                </button>
              </div>
              <div class="dt-modal__content dt-modal__content--scrollable search-dialog__results">
                <ul class="dt-list">
                  <li class="search-dialog__category" role="presentation">SDK</li>
                  <li>
                    <a class="dt-list-item dt-list-item--clickable dt-list-item--selected dt-list-item--divider" href="#">
                      <span class="dt-list-item__text">
                        <span class="dt-breadcrumbs search-result__breadcrumbs">
                          <span class="dt-breadcrumb-item"><span class="dt-breadcrumb-item__content">Methods</span></span>
                        </span>
                        <span class="dt-list-item__label"><mark class="dt-highlight__mark">Events</mark></span>
                        <span class="dt-list-item__description">addEventListener &mdash; This method listens to a specific <mark class="dt-highlight__mark">event</mark> emitted by the Weave instance.</span>
                      </span>
                    </a>
                  </li>
                  <li>
                    <a class="dt-list-item dt-list-item--clickable dt-list-item--divider" href="#">
                      <span class="dt-list-item__text">
                        <span class="dt-breadcrumbs search-result__breadcrumbs">
                          <span class="dt-breadcrumb-item"><span class="dt-breadcrumb-item__content">Methods</span></span>
                        </span>
                        <span class="dt-list-item__label"><mark class="dt-highlight__mark">Events</mark></span>
                        <span class="dt-list-item__description">removeEventListener &mdash; Stops listening to a previously subscribed <mark class="dt-highlight__mark">event</mark>.</span>
                      </span>
                    </a>
                  </li>
                  <li class="search-dialog__category" role="presentation">Guides</li>
                  <li>
                    <a class="dt-list-item dt-list-item--clickable" href="#">
                      <span class="dt-list-item__text">
                        <span class="dt-list-item__label">Getting started</span>
                        <span class="dt-list-item__description">Subscribing to the instance's <mark class="dt-highlight__mark">event</mark> bus from a plugin.</span>
                      </span>
                    </a>
                  </li>
                </ul>
              </div>
              <div class="dt-modal__footer dt-modal__footer--horizontal">
                <span class="dt-modal__footer-left dt-text dt-text--detail-m"><kbd>&uarr;&darr;</kbd> navigate &middot; <kbd>&crarr;</kbd> select &middot; <kbd>esc</kbd> close</span>
              </div>
            </div>
          </div>
        </section>

        <section class="search-dialog-preview__card">
          <h2 class="search-dialog-preview__title dt-text dt-text--title-s">Results (filtered to one module)</h2>
          <div class="search-dialog-preview__panel dt-modal dt-modal--small">
            <div class="dt-modal__container">
              <div class="dt-search-field-minimal dt-search-field-minimal--full-width dt-search-field-minimal--has-value dt-search-field-minimal--focused">
                <span class="dt-search-field-minimal__icon-start" aria-hidden="true">{{icon "search"}}</span>
                <div class="dt-search-field-minimal__input-wrapper">
                  <div class="dt-search-field-minimal__input-container">
                    <input type="search" class="dt-search-field-minimal__input" value="event" readonly>
                  </div>
                </div>
              </div>
              <div class="search-dialog__chips" role="group" aria-label="Filter results by module">
                <button type="button" class="dt-tag dt-tag--solid search-dialog__chip" aria-pressed="false">
                  <span class="dt-tag__label">All</span>
                </button>
                <button type="button" class="dt-tag dt-tag--solid dt-tag--selected search-dialog__chip" aria-pressed="true">
                  <span class="dt-tag__label">SDK</span>
                </button>
                <button type="button" class="dt-tag dt-tag--solid search-dialog__chip" aria-pressed="false">
                  <span class="dt-tag__label">Guides</span>
                </button>
              </div>
              <div class="dt-modal__content dt-modal__content--scrollable search-dialog__results">
                <ul class="dt-list">
                  <li>
                    <a class="dt-list-item dt-list-item--clickable dt-list-item--selected dt-list-item--divider" href="#">
                      <span class="dt-list-item__text">
                        <span class="dt-breadcrumbs search-result__breadcrumbs">
                          <span class="dt-breadcrumb-item"><span class="dt-breadcrumb-item__content">SDK</span></span>
                          <span class="dt-breadcrumb-item"><span class="dt-breadcrumb-item__content">Methods</span></span>
                        </span>
                        <span class="dt-list-item__label"><mark class="dt-highlight__mark">Events</mark></span>
                        <span class="dt-list-item__description">addEventListener &mdash; This method listens to a specific <mark class="dt-highlight__mark">event</mark> emitted by the Weave instance.</span>
                      </span>
                    </a>
                  </li>
                  <li>
                    <a class="dt-list-item dt-list-item--clickable" href="#">
                      <span class="dt-list-item__text">
                        <span class="dt-breadcrumbs search-result__breadcrumbs">
                          <span class="dt-breadcrumb-item"><span class="dt-breadcrumb-item__content">SDK</span></span>
                          <span class="dt-breadcrumb-item"><span class="dt-breadcrumb-item__content">Methods</span></span>
                        </span>
                        <span class="dt-list-item__label"><mark class="dt-highlight__mark">Events</mark></span>
                        <span class="dt-list-item__description">removeEventListener &mdash; Stops listening to a previously subscribed <mark class="dt-highlight__mark">event</mark>.</span>
                      </span>
                    </a>
                  </li>
                </ul>
              </div>
              <div class="dt-modal__footer dt-modal__footer--horizontal">
                <span class="dt-modal__footer-left dt-text dt-text--detail-m"><kbd>&uarr;&darr;</kbd> navigate &middot; <kbd>&crarr;</kbd> select &middot; <kbd>esc</kbd> close</span>
              </div>
            </div>
          </div>
        </section>

        <section class="search-dialog-preview__card">
          <h2 class="search-dialog-preview__title dt-text dt-text--title-s">Empty</h2>
          <div class="search-dialog-preview__panel dt-modal dt-modal--small">
            <div class="dt-modal__container">
              <div class="dt-search-field-minimal dt-search-field-minimal--full-width dt-search-field-minimal--has-value dt-search-field-minimal--focused">
                <span class="dt-search-field-minimal__icon-start" aria-hidden="true">{{icon "search"}}</span>
                <div class="dt-search-field-minimal__input-wrapper">
                  <div class="dt-search-field-minimal__input-container">
                    <input type="search" class="dt-search-field-minimal__input" value="xyzzy" readonly>
                  </div>
                </div>
              </div>
              <div class="dt-modal__content dt-modal__content--scrollable search-dialog__results">
                <div class="dt-empty-state">
                  <div class="dt-empty-state__message">
                    <p class="dt-empty-state__title">No results found</p>
                    <p class="dt-empty-state__description">Try a different search term</p>
                  </div>
                </div>
              </div>
              <div class="dt-modal__footer dt-modal__footer--horizontal">
                <span class="dt-modal__footer-left dt-text dt-text--detail-m"><kbd>&uarr;&darr;</kbd> navigate &middot; <kbd>&crarr;</kbd> select &middot; <kbd>esc</kbd> close</span>
              </div>
            </div>
          </div>
        </section>

      </div>
    </main>
{{> footer-scripts}}
  </body>
</html>
