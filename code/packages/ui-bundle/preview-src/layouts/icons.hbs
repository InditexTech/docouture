<!--
  Preview-only layout. Lives in preview-src/layouts, not src/layouts, so it is
  never packed into the published UI bundle. Icon data comes straight from
  lucide-static's own combined sprite (a normal devDependency, always
  installed), not from the vendored `src/img/icons.yml` manifest — see
  gulp.d/lib/load-icon-catalog.js. The sprite is copied to
  `_/img/preview-icons/` for this preview only.

  No site chrome (header, footer copy): this is a dev-only catalog, not a page
  any real Antora site would use. `footer-scripts` stays so `site.js` still
  loads.
-->
<!DOCTYPE html>
<html lang="en">
  <head>
{{> head defaultPageTitle='Icons Catalog'}}
    <link rel="stylesheet" href="{{{siteRootPath}}}/preview.css">
  </head>
  <body class="icons-page">
    <main class="icons">
      <a class="icons__back dt-text dt-text--body-m" href="{{{siteRootPath}}}/index.html">{{icon "arrow-left"}} UI Preview</a>
{{#if icons.available}}
      <div class="icons__toolbar">
        <div class="icons__search">
          <div class="dt-search-field-minimal dt-search-field-minimal--full-width">
            <span class="dt-search-field-minimal__icon-start">{{icon "search"}}</span>
            <div class="dt-search-field-minimal__input-wrapper">
              <div class="dt-search-field-minimal__input-container">
                <input class="dt-search-field-minimal__input icons__filter" type="search" placeholder="Filter by name&hellip;" aria-label="Filter icons">
              </div>
            </div>
          </div>
        </div>
        <div class="dt-option-picker icons__size" role="group" aria-label="Icon size">
          <div class="dt-option-picker-item dt-option-picker-item--hover">
            <button type="button" class="dt-option-picker-button" data-size="16" aria-pressed="false">
              <span class="dt-option-picker-button__content"><span class="dt-option-picker-button__label">16</span></span>
            </button>
          </div>
          <div class="dt-option-picker-item dt-option-picker-item--hover dt-option-picker-item--selected">
            <button type="button" class="dt-option-picker-button dt-option-picker-button--selected" data-size="24" aria-pressed="true">
              <span class="dt-option-picker-button__content"><span class="dt-option-picker-button__label">24</span></span>
            </button>
          </div>
          <div class="dt-option-picker-item dt-option-picker-item--hover">
            <button type="button" class="dt-option-picker-button" data-size="48" aria-pressed="false">
              <span class="dt-option-picker-button__content"><span class="dt-option-picker-button__label">48</span></span>
            </button>
          </div>
        </div>
        <span class="icons__count dt-text dt-text--label-l">{{icons.total}} icons</span>
      </div>
      <ul class="icons__grid" data-size="24">
{{#each icons.icons}}
        <li>
          <button
            type="button"
            class="icon-cell{{#if this.vendored}} is-vendored{{/if}}"
            data-search="{{this.name}}"
            data-icon-name="{{this.name}}"
          >
            <svg class="dt-icon" aria-hidden="true" focusable="false">
              <use href="{{@root.uiRootPath}}/img/preview-icons/sprite.svg#{{this.name}}"></use>
            </svg>
            <span class="icon-cell__name dt-text dt-text--detail-m">{{this.name}}</span>
{{#if this.vendored}}
            <span class="icon-cell__vendored dt-text dt-text--detail-m-high">vendored</span>
{{/if}}
          </button>
        </li>
{{/each}}
      </ul>
{{else}}
      <div class="icons__missing">
        <p>lucide-static is not installed, so there is nothing to catalog yet.</p>
        <p>Run <code>pnpm install</code>, then restart the preview.</p>
        <p>This is separate from <code>just icons-build</code>, which only regenerates the small vendored sprite (<code>src/img/icons.svg</code>) that the published bundle ships.</p>
      </div>
{{/if}}
    </main>
    <div class="icons__toast" role="status" aria-live="polite"></div>
{{> footer-scripts}}
    <script>
      (function () {
        var main = document.querySelector('.icons')
        if (!main) return

        var filter = main.querySelector('.icons__filter')
        var toast = document.querySelector('.icons__toast')

        if (filter) {
          filter.addEventListener('input', function () {
            var term = filter.value.trim().toLowerCase()
            main.querySelectorAll('.icon-cell').forEach(function (cell) {
              var haystack = (cell.getAttribute('data-search') || '').toLowerCase()
              cell.parentElement.classList.toggle('is-hidden', term !== '' && haystack.indexOf(term) === -1)
            })
          })
        }

        main.querySelectorAll('.icons__size .dt-option-picker-button').forEach(function (button) {
          button.addEventListener('click', function () {
            var size = button.getAttribute('data-size')
            main.querySelectorAll('.icons__size .dt-option-picker-button').forEach(function (b) {
              var isSelected = b === button
              b.setAttribute('aria-pressed', String(isSelected))
              b.classList.toggle('dt-option-picker-button--selected', isSelected)
              b.closest('.dt-option-picker-item').classList.toggle('dt-option-picker-item--selected', isSelected)
            })
            main.querySelectorAll('.icons__grid').forEach(function (grid) {
              grid.setAttribute('data-size', size)
            })
          })
        })

        var toastTimer
        main.querySelectorAll('.icon-cell').forEach(function (cell) {
          cell.addEventListener('click', function () {
            var snippet = '\{{icon "' + cell.getAttribute('data-icon-name') + '"}}'
            var done = function () {
              if (!toast) return
              toast.textContent = 'Copied ' + snippet
              toast.classList.add('is-visible')
              clearTimeout(toastTimer)
              toastTimer = setTimeout(function () { toast.classList.remove('is-visible') }, 1500)
            }
            if (navigator.clipboard && navigator.clipboard.writeText) {
              navigator.clipboard.writeText(snippet).then(done, done)
            } else {
              done()
            }
          })
        })
      })()
    </script>
  </body>
</html>
