<!--
  Preview-only layout. Lives in preview-src/layouts, not src/layouts, so it is
  never packed into the published UI bundle. Icon data comes from the
  gitignored `.icons/` mirror (`just icons-fetch`), not from the vendored
  `src/img/icons.yml` manifest — see gulp.d/lib/load-icon-catalog.js. Sprites
  referenced here are copied to `_/img/preview-icons/` for this preview only.

  No site chrome (header, footer copy): this is a dev-only catalog, not a page
  any real Antora site would use. `footer-scripts` stays so `site.js` still
  loads.
-->
<!DOCTYPE html>
<html lang="en">
  <head>
{{> head defaultPageTitle='Icons Catalog'}}
    <link rel="stylesheet" href="{{{siteRootPath}}}/preview.css">
  </head>
  <body class="icons-page">
    <main class="icons">
      <a class="icons__back ids-text ids-text--body-m" href="{{{siteRootPath}}}/index.html">{{icon "arrows" "arrow-left-outlined"}} UI Preview</a>
{{#if icons.available}}
      <div class="icons__toolbar">
        <div class="icons__search">
          <div class="ids-search-field-minimal ids-search-field-minimal--full-width">
            <span class="ids-search-field-minimal__icon-start">{{icon "actions" "search-outlined"}}</span>
            <div class="ids-search-field-minimal__input-wrapper">
              <div class="ids-search-field-minimal__input-container">
                <input class="ids-search-field-minimal__input icons__filter" type="search" placeholder="Filter by name or group&hellip;" aria-label="Filter icons">
              </div>
            </div>
          </div>
        </div>
        <div class="ids-option-picker icons__size" role="group" aria-label="Icon size">
          <div class="ids-option-picker-item ids-option-picker-item--hover">
            <button type="button" class="ids-option-picker-button" data-size="16" aria-pressed="false">
              <span class="ids-option-picker-button__content"><span class="ids-option-picker-button__label">16</span></span>
            </button>
          </div>
          <div class="ids-option-picker-item ids-option-picker-item--hover ids-option-picker-item--selected">
            <button type="button" class="ids-option-picker-button ids-option-picker-button--selected" data-size="24" aria-pressed="true">
              <span class="ids-option-picker-button__content"><span class="ids-option-picker-button__label">24</span></span>
            </button>
          </div>
          <div class="ids-option-picker-item ids-option-picker-item--hover">
            <button type="button" class="ids-option-picker-button" data-size="48" aria-pressed="false">
              <span class="ids-option-picker-button__content"><span class="ids-option-picker-button__label">48</span></span>
            </button>
          </div>
        </div>
        <span class="icons__count ids-text ids-text--label-l">{{icons.total}} icons</span>
      </div>
{{#each icons.groups}}
      <section class="icons__group" data-group="{{this.name}}">
        <h2 class="icons__group-title ids-text ids-text--title-s">{{this.name}}</h2>
        <ul class="icons__grid" data-size="24">
{{#each this.icons}}
          <li>
            <button
              type="button"
              class="icon-cell{{#if this.vendored}} is-vendored{{/if}}"
              data-search="{{../name}} {{this.name}}"
              data-group="{{../name}}"
              data-icon-name="{{this.name}}"
            >
              <svg class="ids-icon" aria-hidden="true" focusable="false">
                <use href="{{@root.uiRootPath}}/img/preview-icons/sw-icons-{{../name}}.symbol.svg#{{this.id}}"></use>
              </svg>
              <span class="icon-cell__name ids-text ids-text--detail-m">{{this.name}}</span>
{{#if this.vendored}}
              <span class="icon-cell__vendored ids-text ids-text--detail-m-high">vendored</span>
{{/if}}
            </button>
          </li>
{{/each}}
        </ul>
      </section>
{{/each}}
{{else}}
      <div class="icons__missing">
        <p>The icon mirror is not present, so there is nothing to catalog yet.</p>
        <p>Run <code>just icons-fetch</code> to pull the IOP Design System sprites, then restart the preview.</p>
        <p>This is separate from <code>just icons-build</code>, which only regenerates the small vendored sprite (<code>src/img/ids-icons.svg</code>) that the published bundle ships.</p>
      </div>
{{/if}}
    </main>
    <div class="icons__toast" role="status" aria-live="polite"></div>
{{> footer-scripts}}
    <script>
      (function () {
        var main = document.querySelector('.icons')
        if (!main) return

        var filter = main.querySelector('.icons__filter')
        var toast = document.querySelector('.icons__toast')

        if (filter) {
          filter.addEventListener('input', function () {
            var term = filter.value.trim().toLowerCase()
            main.querySelectorAll('.icon-cell').forEach(function (cell) {
              var haystack = (cell.getAttribute('data-search') || '').toLowerCase()
              cell.parentElement.classList.toggle('is-hidden', term !== '' && haystack.indexOf(term) === -1)
            })
            main.querySelectorAll('.icons__group').forEach(function (group) {
              var anyVisible = Array.prototype.some.call(
                group.querySelectorAll('li'),
                function (li) { return !li.classList.contains('is-hidden') }
              )
              group.classList.toggle('is-hidden', !anyVisible)
            })
          })
        }

        main.querySelectorAll('.icons__size .ids-option-picker-button').forEach(function (button) {
          button.addEventListener('click', function () {
            var size = button.getAttribute('data-size')
            main.querySelectorAll('.icons__size .ids-option-picker-button').forEach(function (b) {
              var isSelected = b === button
              b.setAttribute('aria-pressed', String(isSelected))
              b.classList.toggle('ids-option-picker-button--selected', isSelected)
              b.closest('.ids-option-picker-item').classList.toggle('ids-option-picker-item--selected', isSelected)
            })
            main.querySelectorAll('.icons__grid').forEach(function (grid) {
              grid.setAttribute('data-size', size)
            })
          })
        })

        var toastTimer
        main.querySelectorAll('.icon-cell').forEach(function (cell) {
          cell.addEventListener('click', function () {
            var snippet = '\{{icon "' + cell.getAttribute('data-group') + '" "' + cell.getAttribute('data-icon-name') + '"}}'
            var done = function () {
              if (!toast) return
              toast.textContent = 'Copied ' + snippet
              toast.classList.add('is-visible')
              clearTimeout(toastTimer)
              toastTimer = setTimeout(function () { toast.classList.remove('is-visible') }, 1500)
            }
            if (navigator.clipboard && navigator.clipboard.writeText) {
              navigator.clipboard.writeText(snippet).then(done, done)
            } else {
              done()
            }
          })
        })
      })()
    </script>
  </body>
</html>
