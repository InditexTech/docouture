# Peer ranges across the gulp/postcss ecosystem are noisy; do not fail installs on them.
strict-peer-dependencies=false
auto-install-peers=true

# Registry routing.
#
# The default registry is pinned here rather than inherited. A developer whose
# ~/.npmrc sets `registry=` to an internal mirror would otherwise resolve every
# package through it, and CI — which has no such default — would resolve the
# same packages from somewhere else. Pinning keeps the two identical.
#
# The lockfile records a `tarball:` URL only for packages whose registry differs
# from this default — after removing the IOP Design System dependency (see
# below), nothing in this workspace's lockfile does anymore. Everything
# resolves against whatever this points at.
registry=https://registry.npmjs.org/

# The IOP Design System (the only reason this workspace ever needed
# Artifactory) is not installed here. It never enters this pnpm workspace —
# see code/tools/ids/README.md for where it lives instead, and why. A plain
# `pnpm install` from this directory needs no credential and no VPN.
