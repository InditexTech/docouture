{{!--
  Header toolbar — full-width, replaces the inherited antora-ui-default navbar
  (see GH issue #7). Structure and modifiers mirror the Figma frame linked from
  the issue; DS component CSS vendored via src/css/ids-components.yml.

  Search is explicitly out of scope: the field below is focusable and styled
  but carries no name, no form and no JS handler, so it can never submit
  anywhere. Do not wire it up here.
--}}
<header class="header-toolbar">
  <div class="header-toolbar__search">
    <div class="ids-search-field-minimal">
      <div class="ids-search-field-minimal__input-container">
        <div class="ids-search-field-minimal__icon-start" aria-hidden="true">{{icon "actions" "search-outlined"}}</div>
        <div class="ids-search-field-minimal__input-wrapper">
          <input type="search" class="ids-search-field-minimal__input" placeholder="type here..." aria-label="Search the docs" tabindex="0">
        </div>
      </div>
    </div>
  </div>
  <div class="header-toolbar__actions">
{{> page-versions}}
{{> repo-link}}
{{> theme-toggle}}
  </div>
</header>
