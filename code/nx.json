{
  "$schema": "./node_modules/nx/schemas/nx-schema.json",
  "defaultBase": "main",
  "namedInputs": {
    "default": ["{projectRoot}/**/*", "sharedGlobals"],
    "production": [
      "default",
      "!{projectRoot}/**/*.md",
      "!{projectRoot}/.stylelintrc.json",
      "!{projectRoot}/eslint.config.mjs"
    ],
    "sharedGlobals": [
      "{workspaceRoot}/tsconfig.base.json",
      "{workspaceRoot}/eslint.config.mjs",
      "{workspaceRoot}/.prettierrc"
    ]
  },
  "targetDefaults": {
    "build": {
      "cache": true,
      "dependsOn": ["^build"],
      "inputs": ["production", "^production"],
      "outputs": ["{projectRoot}/build"]
    },
    "typecheck": {
      "cache": true,
      "inputs": ["default", "^default"]
    },
    "lint": {
      "cache": true,
      "inputs": ["default"]
    },
    "clean": {
      "cache": false
    },
    "preview": {
      "cache": false
    },
    "icons:fetch": {
      "cache": false
    },
    "icons:build": {
      "cache": false
    },
    "icons:search": {
      "cache": false
    },
    "dev": {
      "cache": false
    }
  },
  "analytics": false,
  "tui": {
    "enabled": false
  }
}
