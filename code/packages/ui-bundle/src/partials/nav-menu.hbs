{{!--
  page.navigation is Antora's own array of root menus — in practice always
  one element, `{ root: true, items: [...] }`, never carrying its own
  `content` or `url`. nav-tree.hbs treats an item with neither as a
  transparent wrapper (see its own comment) so real top-level entries land
  at level 0, not level 1.
--}}
{{#each page.navigation}}
{{> nav-tree navigation=./items level=0}}
{{/each}}
