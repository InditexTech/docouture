<!--
  Preview-only layout. Lives in preview-src/layouts, not src/layouts, so it is
  never packed into the published UI bundle — this is the entry page of
  `just preview-ui`, not a page any real Antora site would use.
-->
<!DOCTYPE html>
<html lang="en">
  <head>
{{> head defaultPageTitle='UI Preview'}}
    <style>
      body.hub-page .hub {
        margin: 0 auto;
        max-width: calc(900 / 18 * 1rem);
        padding: var(--ids-size-200) var(--ids-size-100);
      }

      body.hub-page .hub__intro {
        margin-bottom: var(--ids-size-200);
      }

      body.hub-page .hub__menu {
        display: grid;
        gap: var(--ids-size-100);
        grid-template-columns: repeat(auto-fit, minmax(calc(220 / 18 * 1rem), 1fr));
        list-style: none;
        margin: 0;
        padding: 0;
      }

      body.hub-page .hub-card {
        align-items: flex-start;
        background: var(--ids-color-bg-low);
        border: var(--ids-size-border-default) solid var(--ids-color-border-low);
        border-radius: var(--ids-size-radius-rounded);
        color: inherit;
        display: flex;
        flex-direction: column;
        gap: var(--ids-size-50);
        height: 100%;
        padding: var(--ids-size-150);
      }

      body.hub-page .hub-card:hover {
        background: var(--ids-color-bg-states-hover);
        text-decoration: none;
      }

      body.hub-page .hub-card .ids-icon {
        block-size: var(--ids-size-150);
        inline-size: var(--ids-size-150);
      }

      body.hub-page .hub-card__title {
        font-weight: var(--ids-typo-font-weight-high);
      }

      body.hub-page .hub-card__desc {
        color: var(--body-font-color);
        font-size: 0.875em;
        opacity: 0.75;
      }
    </style>
  </head>
  <body class="hub-page">
{{> header}}
    <main class="hub">
      <div class="hub__intro">
{{{page.contents}}}
      </div>
      <ul class="hub__menu">
        <li>
          <a class="hub-card" href="landing.html">
            {{icon "others" "home-outlined"}}
            <span class="hub-card__title">Landing test page</span>
            <span class="hub-card__desc">Site chrome around a normal doc page: header, toolbar, breadcrumbs, nav tree, TOC, pagination, footer — with the home-link marked current.</span>
          </a>
        </li>
        <li>
          <a class="hub-card" href="content.html">
            {{icon "design" "grid-outlined"}}
            <span class="hub-card__title">Content test page</span>
            <span class="hub-card__desc">Long-form AsciiDoc kitchen sink: admonitions, tables, code blocks, collapsibles, media, footnotes.</span>
          </a>
        </li>
        <li>
          <a class="hub-card" href="icons.html">
            {{icon "actions" "search-outlined"}}
            <span class="hub-card__title">Icons catalog</span>
            <span class="hub-card__desc">Every icon in the IOP Design System mirror, flagged where it is already vendored into this bundle's sprite.</span>
          </a>
        </li>
        <li>
          <a class="hub-card" href="404.html">
            {{icon "alerts" "warning-outlined"}}
            <span class="hub-card__title">404 page</span>
            <span class="hub-card__desc">The not-found page.</span>
          </a>
        </li>
      </ul>
    </main>
{{> footer}}
  </body>
</html>
