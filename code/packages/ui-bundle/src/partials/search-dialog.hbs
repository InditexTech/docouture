{{!--
  GH-66 (S2): the search dialog shell. Static markup, no behaviour — the
  dialog is a native <dialog>, never `showModal()`'d by anything here, so it
  renders nothing on a real page unless opened from devtools for review (see
  the issue's acceptance criteria). GH-67 (S3) adds src/js/12-search.ts:
  opening it from header-content.hbs's trigger, loading the site's search
  index (GH-65), and populating/hiding the states below as the reader types.

  Included once from header.hbs, so it exists on every page — a dialog is a
  page-level overlay, not something that belongs to the header's own DOM
  subtree.

  `<dialog>` over a hand-rolled overlay + focus trap: `showModal()` gives the
  top layer, the platform focus trap, Esc-to-close and an implicit ::backdrop
  for free — the same things src/js/05-nav-modules.ts has to hand-roll for
  the side menu's drawer, because that one isn't a <dialog>. The DS's own
  `.ids-modal` CSS assumes its own React portal (`#ids-modal-root`, a
  fixed/pointer-events:none full-viewport wrapper) rather than a <dialog>;
  search-dialog.css resets the UA <dialog> box model onto that same
  flex-centering layout instead of rendering the portal wrapper, so `.ids-
  modal`'s own rules apply unmodified.

  Content area (`.ids-modal__content--scrollable`) ships empty: which of
  loading / results / empty-state it should hold depends entirely on a query
  nothing has run yet, so there is nothing correct to pre-render here. All
  four states — idle (this), loading, results, empty — are reviewed together,
  with fixture content, from the dedicated preview page (preview-src/layouts/
  search-dialog.hbs) rather than guessed at in the shipped partial.
--}}
<dialog id="search-dialog" class="ids-modal ids-modal--small search-dialog" aria-label="Search">
  <div class="ids-overlay ids-overlay--visible search-dialog__overlay">
    <div class="ids-overlay__content"></div>
  </div>
  <div class="ids-modal__container search-dialog__container">
    <div class="ids-search-field-minimal ids-search-field-minimal--full-width search-dialog__field">
      <span class="ids-search-field-minimal__icon-start" aria-hidden="true">{{icon "actions" "search-outlined"}}</span>
      <div class="ids-search-field-minimal__input-wrapper">
        <div class="ids-search-field-minimal__input-container">
          <input type="search" class="ids-search-field-minimal__input" placeholder="Search the docs" aria-label="Search the docs" disabled>
        </div>
      </div>
      <button type="button" class="ids-button ids-button--ghost ids-button--icon-only search-dialog__close" aria-label="Close search" disabled>
        <span class="ids-button__content">
          <span class="ids-button__icon ids-button__icon-icon">{{icon "actions" "close-large-outlined"}}</span>
        </span>
      </button>
    </div>
    <div class="ids-modal__content ids-modal__content--scrollable search-dialog__results"></div>
    <div class="ids-modal__footer ids-modal__footer--horizontal search-dialog__footer">
      <span class="ids-modal__footer-left ids-text ids-text--detail-m search-dialog__hints">
        <kbd>&uarr;&darr;</kbd> navigate &middot; <kbd>&crarr;</kbd> select &middot; <kbd>esc</kbd> close
      </span>
    </div>
  </div>
</dialog>
