# Peer ranges across the gulp/postcss ecosystem are noisy; do not fail installs on them.
strict-peer-dependencies=false
auto-install-peers=true

# Registry routing.
#
# The default registry is pinned here rather than inherited. A developer whose
# ~/.npmrc sets `registry=` to an internal mirror would otherwise resolve every
# package through it, and CI — which has no such default — would resolve the
# same packages from somewhere else. Pinning keeps the two identical.
#
# The lockfile records a `tarball:` URL only for packages whose registry differs
# from this default, so the five @inditex entries are the only host-specific
# lines in it. Everything else is resolved against whatever this points at.
registry=https://registry.npmjs.org/

# The IOP Design System packages are not on the public registry. This is the
# only scope that needs Artifactory, and the only reason an install here needs
# credentials at all.
#
# Auth deliberately lives outside this file: developers already have it in
# ~/.npmrc (as `_auth`), and CI appends its own line from a secret. Declaring a
# project-level token for the same registry that ~/.npmrc authenticates with
# `_auth` makes which credential wins ambiguous.
@inditex:registry=https://inditex.jfrog.io/artifactory/api/npm/node-public/
