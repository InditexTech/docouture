  "repository": {
    "type": "git",
    "url": "https://github.com/InditexTech/docouture.git",
    "directory": "code/packages/asciidoc-extensions"
  },
  "license": "Apache-2.0",
  "main": "index.js",
  "files": [
    "index.js",
    "lib",
    "README.md",
    "LICENSE",
    "NOTICE"
  ],
  "engines": {
    "node": ">=24.0.0"
  },
  "scripts": {
    "typecheck": "tsc -p tsconfig.json --noEmit",
