{{!--
  Preview-only layout (GH-66). Lives in preview-src/layouts, not src/layouts,
  so it is never packed into the published UI bundle — see icons.hbs for the
  same convention.

  Reviews the dialog's content states — idle, loading, results (with module
  chips), filtered results, recent searches, and empty — side by side. Each
  card renders `.ids-modal`/`.ids-modal__container` directly (not the real
  `<dialog>`): `search-dialog.hbs` (included on every real page via
  header.hbs) already carries the outer `<dialog>` + `.ids-overlay`, and
  `.ids-overlay` is `position: fixed` to the *viewport* — fine for one dialog
  on a real page, wrong for several shown at once here, which would stack
  full-page scrims. The panel is what actually differs per state, so that's
  what this page compares; the outer shell (positioning, the deliberate DS
  deviation in search-dialog.css, the backdrop) is reviewed live, per the
  issue's own acceptance criteria, by opening the real dialog from devtools
  on any page.

  Light/dark: this project has no in-preview theme toggle (head-prelude.hbs
  follows `prefers-color-scheme` with no override UI here) — switch with
  devtools' rendering emulation to review both.

  GH-68 (S4): the fullscreen variant and the xs-only floating trigger are
  breakpoint- and viewport-fixed-position concerns respectively — same
  reasoning as the paragraph above, both are reviewed live (devtools
  responsive mode) rather than faked into this static grid.

  GH-69 (S5): the module chips and recents rows below are static fixture
  markup, not rendered by 12-search.ts/13-search-recents.ts — this page has
  no search index and no localStorage state to drive them from. They mirror
  exactly what those files build at runtime (same classes, same structure)
  so the two states are still reviewable without a live component with
  several modules and a search history to hand.
--}}
<!DOCTYPE html>
<html lang="en">
  <head>
{{> head defaultPageTitle='Search Dialog States'}}
    <link rel="stylesheet" href="{{{siteRootPath}}}/preview.css">
  </head>
  <body class="search-dialog-page">
    <main class="search-dialog-preview">
      <a class="search-dialog-preview__back ids-text ids-text--body-m" href="{{{siteRootPath}}}/index.html">{{icon "arrows" "arrow-left-outlined"}} UI Preview</a>
      <div class="search-dialog-preview__grid">

        <section class="search-dialog-preview__card">
          <h2 class="search-dialog-preview__title ids-text ids-text--title-s">Idle</h2>
          <div class="search-dialog-preview__panel ids-modal ids-modal--small">
            <div class="ids-modal__container">
              <div class="ids-search-field-minimal ids-search-field-minimal--full-width">
                <span class="ids-search-field-minimal__icon-start" aria-hidden="true">{{icon "actions" "search-outlined"}}</span>
                <div class="ids-search-field-minimal__input-wrapper">
                  <div class="ids-search-field-minimal__input-container">
                    <input type="search" class="ids-search-field-minimal__input" placeholder="Search the docs" readonly>
                  </div>
                </div>
              </div>
              <div class="ids-modal__content ids-modal__content--scrollable search-dialog__results"></div>
              <div class="ids-modal__footer ids-modal__footer--horizontal">
                <span class="ids-modal__footer-left ids-text ids-text--detail-m"><kbd>&uarr;&darr;</kbd> navigate &middot; <kbd>&crarr;</kbd> select &middot; <kbd>esc</kbd> close</span>
              </div>
            </div>
          </div>
        </section>

        <section class="search-dialog-preview__card">
          <h2 class="search-dialog-preview__title ids-text ids-text--title-s">Recent searches</h2>
          <div class="search-dialog-preview__panel ids-modal ids-modal--small">
            <div class="ids-modal__container">
              <div class="ids-search-field-minimal ids-search-field-minimal--full-width">
                <span class="ids-search-field-minimal__icon-start" aria-hidden="true">{{icon "actions" "search-outlined"}}</span>
                <div class="ids-search-field-minimal__input-wrapper">
                  <div class="ids-search-field-minimal__input-container">
                    <input type="search" class="ids-search-field-minimal__input" placeholder="Search the docs" readonly>
                  </div>
                </div>
              </div>
              <div class="ids-modal__content ids-modal__content--scrollable search-dialog__results">
                <p class="search-recents__heading">Recent searches</p>
                <ul class="ids-list">
                  <li class="ids-list-item ids-list-item--clickable search-recents__row">
                    <span class="ids-list-item__icon-start" aria-hidden="true">{{icon "time" "history-outlined"}}</span>
                    <span class="ids-list-item__text">
                      <span class="ids-list-item__label">event listener</span>
                    </span>
                    <span class="ids-list-item__content-end">
                      <button type="button" class="ids-button ids-button--ghost ids-button--icon-only" aria-label="Remove &ldquo;event listener&rdquo; from recent searches">
                        <span class="ids-button__content">
                          <span class="ids-button__icon ids-button__icon-icon">{{icon "actions" "close-small-outlined"}}</span>
                        </span>
                      </button>
                    </span>
                  </li>
                  <li class="ids-list-item ids-list-item--clickable search-recents__row">
                    <span class="ids-list-item__icon-start" aria-hidden="true">{{icon "time" "history-outlined"}}</span>
                    <span class="ids-list-item__text">
                      <span class="ids-list-item__label">getting started</span>
                    </span>
                    <span class="ids-list-item__content-end">
                      <button type="button" class="ids-button ids-button--ghost ids-button--icon-only" aria-label="Remove &ldquo;getting started&rdquo; from recent searches">
                        <span class="ids-button__content">
                          <span class="ids-button__icon ids-button__icon-icon">{{icon "actions" "close-small-outlined"}}</span>
                        </span>
                      </button>
                    </span>
                  </li>
                </ul>
              </div>
              <div class="ids-modal__footer ids-modal__footer--horizontal">
                <span class="ids-modal__footer-left ids-text ids-text--detail-m"><kbd>&uarr;&darr;</kbd> navigate &middot; <kbd>&crarr;</kbd> select &middot; <kbd>esc</kbd> close</span>
              </div>
            </div>
          </div>
        </section>

        <section class="search-dialog-preview__card">
          <h2 class="search-dialog-preview__title ids-text ids-text--title-s">Loading</h2>
          <div class="search-dialog-preview__panel ids-modal ids-modal--small">
            <div class="ids-modal__container">
              <div class="ids-search-field-minimal ids-search-field-minimal--full-width ids-search-field-minimal--has-value ids-search-field-minimal--focused">
                <span class="ids-search-field-minimal__icon-start" aria-hidden="true">{{icon "actions" "search-outlined"}}</span>
                <div class="ids-search-field-minimal__input-wrapper">
                  <div class="ids-search-field-minimal__input-container">
                    <input type="search" class="ids-search-field-minimal__input" value="weave" readonly>
                  </div>
                </div>
              </div>
              <div class="ids-modal__content ids-modal__content--scrollable search-dialog__results">
                <div class="ids-loader" aria-hidden="true">
                  <span class="ids-loader__circle ids-loader__circle--medium"><span></span></span>
                  <span class="ids-loader__label">Loading the search index&hellip;</span>
                </div>
              </div>
              <div class="ids-modal__footer ids-modal__footer--horizontal">
                <span class="ids-modal__footer-left ids-text ids-text--detail-m"><kbd>&uarr;&darr;</kbd> navigate &middot; <kbd>&crarr;</kbd> select &middot; <kbd>esc</kbd> close</span>
              </div>
            </div>
          </div>
        </section>

        <section class="search-dialog-preview__card">
          <h2 class="search-dialog-preview__title ids-text ids-text--title-s">Results (module chips, All)</h2>
          <div class="search-dialog-preview__panel ids-modal ids-modal--small">
            <div class="ids-modal__container">
              <div class="ids-search-field-minimal ids-search-field-minimal--full-width ids-search-field-minimal--has-value ids-search-field-minimal--focused">
                <span class="ids-search-field-minimal__icon-start" aria-hidden="true">{{icon "actions" "search-outlined"}}</span>
                <div class="ids-search-field-minimal__input-wrapper">
                  <div class="ids-search-field-minimal__input-container">
                    <input type="search" class="ids-search-field-minimal__input" value="event" readonly>
                  </div>
                </div>
              </div>
              <div class="search-dialog__chips" role="group" aria-label="Filter results by module">
                <button type="button" class="ids-tag ids-tag--solid ids-tag--selected search-dialog__chip" aria-pressed="true">
                  <span class="ids-tag__label">All</span>
                </button>
                <button type="button" class="ids-tag ids-tag--solid search-dialog__chip" aria-pressed="false">
                  <span class="ids-tag__label">SDK</span>
                </button>
                <button type="button" class="ids-tag ids-tag--solid search-dialog__chip" aria-pressed="false">
                  <span class="ids-tag__label">Guides</span>
                </button>
              </div>
              <div class="ids-modal__content ids-modal__content--scrollable search-dialog__results">
                <ul class="ids-list">
                  <li class="search-dialog__category" role="presentation">SDK</li>
                  <li>
                    <a class="ids-list-item ids-list-item--clickable ids-list-item--selected ids-list-item--divider" href="#">
                      <span class="ids-list-item__text">
                        <span class="ids-breadcrumbs search-result__breadcrumbs">
                          <span class="ids-breadcrumb-item"><span class="ids-breadcrumb-item__content">Methods</span></span>
                        </span>
                        <span class="ids-list-item__label"><mark class="ids-highlight__mark">Events</mark></span>
                        <span class="ids-list-item__description">addEventListener &mdash; This method listens to a specific <mark class="ids-highlight__mark">event</mark> emitted by the Weave instance.</span>
                      </span>
                    </a>
                  </li>
                  <li>
                    <a class="ids-list-item ids-list-item--clickable ids-list-item--divider" href="#">
                      <span class="ids-list-item__text">
                        <span class="ids-breadcrumbs search-result__breadcrumbs">
                          <span class="ids-breadcrumb-item"><span class="ids-breadcrumb-item__content">Methods</span></span>
                        </span>
                        <span class="ids-list-item__label"><mark class="ids-highlight__mark">Events</mark></span>
                        <span class="ids-list-item__description">removeEventListener &mdash; Stops listening to a previously subscribed <mark class="ids-highlight__mark">event</mark>.</span>
                      </span>
                    </a>
                  </li>
                  <li class="search-dialog__category" role="presentation">Guides</li>
                  <li>
                    <a class="ids-list-item ids-list-item--clickable" href="#">
                      <span class="ids-list-item__text">
                        <span class="ids-list-item__label">Getting started</span>
                        <span class="ids-list-item__description">Subscribing to the instance's <mark class="ids-highlight__mark">event</mark> bus from a plugin.</span>
                      </span>
                    </a>
                  </li>
                </ul>
              </div>
              <div class="ids-modal__footer ids-modal__footer--horizontal">
                <span class="ids-modal__footer-left ids-text ids-text--detail-m"><kbd>&uarr;&darr;</kbd> navigate &middot; <kbd>&crarr;</kbd> select &middot; <kbd>esc</kbd> close</span>
              </div>
            </div>
          </div>
        </section>

        <section class="search-dialog-preview__card">
          <h2 class="search-dialog-preview__title ids-text ids-text--title-s">Results (filtered to one module)</h2>
          <div class="search-dialog-preview__panel ids-modal ids-modal--small">
            <div class="ids-modal__container">
              <div class="ids-search-field-minimal ids-search-field-minimal--full-width ids-search-field-minimal--has-value ids-search-field-minimal--focused">
                <span class="ids-search-field-minimal__icon-start" aria-hidden="true">{{icon "actions" "search-outlined"}}</span>
                <div class="ids-search-field-minimal__input-wrapper">
                  <div class="ids-search-field-minimal__input-container">
                    <input type="search" class="ids-search-field-minimal__input" value="event" readonly>
                  </div>
                </div>
              </div>
              <div class="search-dialog__chips" role="group" aria-label="Filter results by module">
                <button type="button" class="ids-tag ids-tag--solid search-dialog__chip" aria-pressed="false">
                  <span class="ids-tag__label">All</span>
                </button>
                <button type="button" class="ids-tag ids-tag--solid ids-tag--selected search-dialog__chip" aria-pressed="true">
                  <span class="ids-tag__label">SDK</span>
                </button>
                <button type="button" class="ids-tag ids-tag--solid search-dialog__chip" aria-pressed="false">
                  <span class="ids-tag__label">Guides</span>
                </button>
              </div>
              <div class="ids-modal__content ids-modal__content--scrollable search-dialog__results">
                <ul class="ids-list">
                  <li>
                    <a class="ids-list-item ids-list-item--clickable ids-list-item--selected ids-list-item--divider" href="#">
                      <span class="ids-list-item__text">
                        <span class="ids-breadcrumbs search-result__breadcrumbs">
                          <span class="ids-breadcrumb-item"><span class="ids-breadcrumb-item__content">SDK</span></span>
                          <span class="ids-breadcrumb-item"><span class="ids-breadcrumb-item__content">Methods</span></span>
                        </span>
                        <span class="ids-list-item__label"><mark class="ids-highlight__mark">Events</mark></span>
                        <span class="ids-list-item__description">addEventListener &mdash; This method listens to a specific <mark class="ids-highlight__mark">event</mark> emitted by the Weave instance.</span>
                      </span>
                    </a>
                  </li>
                  <li>
                    <a class="ids-list-item ids-list-item--clickable" href="#">
                      <span class="ids-list-item__text">
                        <span class="ids-breadcrumbs search-result__breadcrumbs">
                          <span class="ids-breadcrumb-item"><span class="ids-breadcrumb-item__content">SDK</span></span>
                          <span class="ids-breadcrumb-item"><span class="ids-breadcrumb-item__content">Methods</span></span>
                        </span>
                        <span class="ids-list-item__label"><mark class="ids-highlight__mark">Events</mark></span>
                        <span class="ids-list-item__description">removeEventListener &mdash; Stops listening to a previously subscribed <mark class="ids-highlight__mark">event</mark>.</span>
                      </span>
                    </a>
                  </li>
                </ul>
              </div>
              <div class="ids-modal__footer ids-modal__footer--horizontal">
                <span class="ids-modal__footer-left ids-text ids-text--detail-m"><kbd>&uarr;&darr;</kbd> navigate &middot; <kbd>&crarr;</kbd> select &middot; <kbd>esc</kbd> close</span>
              </div>
            </div>
          </div>
        </section>

        <section class="search-dialog-preview__card">
          <h2 class="search-dialog-preview__title ids-text ids-text--title-s">Empty</h2>
          <div class="search-dialog-preview__panel ids-modal ids-modal--small">
            <div class="ids-modal__container">
              <div class="ids-search-field-minimal ids-search-field-minimal--full-width ids-search-field-minimal--has-value ids-search-field-minimal--focused">
                <span class="ids-search-field-minimal__icon-start" aria-hidden="true">{{icon "actions" "search-outlined"}}</span>
                <div class="ids-search-field-minimal__input-wrapper">
                  <div class="ids-search-field-minimal__input-container">
                    <input type="search" class="ids-search-field-minimal__input" value="xyzzy" readonly>
                  </div>
                </div>
              </div>
              <div class="ids-modal__content ids-modal__content--scrollable search-dialog__results">
                <div class="ids-empty-state">
                  <div class="ids-empty-state__message">
                    <p class="ids-empty-state__title">No results found</p>
                    <p class="ids-empty-state__description">Try a different search term</p>
                  </div>
                </div>
              </div>
              <div class="ids-modal__footer ids-modal__footer--horizontal">
                <span class="ids-modal__footer-left ids-text ids-text--detail-m"><kbd>&uarr;&darr;</kbd> navigate &middot; <kbd>&crarr;</kbd> select &middot; <kbd>esc</kbd> close</span>
              </div>
            </div>
          </div>
        </section>

      </div>
    </main>
{{> footer-scripts}}
  </body>
</html>
