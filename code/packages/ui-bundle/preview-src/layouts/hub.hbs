<!--
  Preview-only layout. Lives in preview-src/layouts, not src/layouts, so it is
  never packed into the published UI bundle — this is the entry page of
  `just preview-ui`, not a page any real Antora site would use.

  No site chrome (header, footer copy): this page only exists to route to the
  other preview pages. `footer-scripts` stays so `site.js` (and the theme
  toggle bootstrap it wires up) still loads.
-->
<!DOCTYPE html>
<html lang="en">
  <head>
{{> head defaultPageTitle='UI Preview'}}
    <link rel="stylesheet" href="{{{siteRootPath}}}/preview.css">
  </head>
  <body class="hub-page">
    <main class="hub">
      <ul class="hub__menu">
        <li>
          <a class="hub-card" href="home.html">
            {{icon "house"}}
            <span class="hub-card__title dt-text dt-text--title-s">Home (landing) page</span>
            <span class="hub-card__desc dt-text dt-text--body-m">The `home` layout: header toolbar in its Home state, side menu collapsed by default, sticky hero column beside a grid of content blocks, site footer.</span>
          </a>
        </li>
        <li>
          <a class="hub-card" href="content.html">
            {{icon "grid-3x3"}}
            <span class="hub-card__title dt-text dt-text--title-s">Content test page</span>
            <span class="hub-card__desc dt-text dt-text--body-m">Long-form AsciiDoc kitchen sink: hero (breadcrumbs, title, excerpt, tags, actions), admonitions, tables, code blocks, collapsibles, media, footnotes.</span>
          </a>
        </li>
        <li>
          <a class="hub-card" href="404.html">
            {{icon "triangle-alert"}}
            <span class="hub-card__title dt-text dt-text--title-s">404 page</span>
            <span class="hub-card__desc dt-text dt-text--body-m">The not-found page.</span>
          </a>
        </li>
        <li>
          <a class="hub-card" href="icons.html">
            {{icon "search"}}
            <span class="hub-card__title dt-text dt-text--title-s">Icons catalog</span>
            <span class="hub-card__desc dt-text dt-text--body-m">Every icon Lucide ships, flagged where it is already vendored into this bundle's sprite.</span>
          </a>
        </li>
        <li>
          <a class="hub-card" href="search-dialog.html">
            {{icon "search"}}
            <span class="hub-card__title dt-text dt-text--title-s">Search dialog states</span>
            <span class="hub-card__desc dt-text dt-text--body-m">The search dialog's panel in its four content states — idle, loading, results, empty — for visual review (GH-66).</span>
          </a>
        </li>
        <li>
          <a class="hub-card" href="page-versions-stable-latest.html">
            {{icon "grid-3x3"}}
            <span class="hub-card__title dt-text dt-text--title-s">Page versions states</span>
            <span class="hub-card__desc dt-text dt-text--body-m">Three real pages, one per current-row relationship the dropdown distinguishes — Latest, an older Stable, Prerelease — each through the real `default` layout so breakpoint, drawer and dark mode are all reviewable too (GH-103).</span>
          </a>
        </li>
      </ul>
    </main>
{{> footer-scripts}}
  </body>
</html>
