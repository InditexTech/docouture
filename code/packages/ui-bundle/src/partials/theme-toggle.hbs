{{!--
  The button carries its own accessible name: src/js/08-theme.ts sets aria-label
  and aria-pressed once it wires the control up, so the icons stay decorative.
--}}
<button class="theme-toggle" type="button" hidden>
  <span class="theme-toggle-icon theme-toggle-icon--light">{{icon "weather" "sunny-outlined"}}</span>
  <span class="theme-toggle-icon theme-toggle-icon--dark">{{icon "accessibility" "moon-outlined"}}</span>
</button>
