{
  "name": "docouture",
  "version": "0.1.0",
  "private": true,
  "description": "docouture documentation, built with Antora",
  "license": "UNLICENSED",
  "engines": {
    "node": ">=24.0.0"
  },
  "packageManager": "pnpm@10.24.0",
  "scripts": {
    "build": "antora --fetch antora-playbook.yml",
    "dev": "docouture dev",
    "clean": "node -e \"require('fs').rmSync('build', { recursive: true, force: true })\""
  },
  "devDependencies": {
    "@inditextech/docouture-cli": "1.3.0",
    "@inditextech/docouture-ui-bundle": "1.3.0",
    "@inditextech/docouture-asciidoc-extensions": "1.3.0",
    "@inditextech/docouture-antora-extensions": "1.3.0",
    "@inditextech/docouture-publish-gh-pages": "1.3.0",
    "antora": "3.2.0"
  },
  "docouture": {
    "publish": {
      "gh-pages": {}
    }
  }
}
