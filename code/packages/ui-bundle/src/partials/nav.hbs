{{!--
  Side menu (see GH issue #8). Breakpoint behaviour (side-menu.css):
  - l (>=1680): persistent 320px column, pushes the header and content over
    via --side-menu-offset (vars.css). No scrim, no drawer header. Full
    brand block: logo + product name (nav-brand.hbs).
  - m/s (513-1679): overlay drawer, narrower padding/gap, a 0.5px solid
    right rule instead of l's dashed one, and a white 80% scrim
    (.side-menu-scrim, a sibling so it can sit behind the panel and still
    catch the outside-click that closes it — see 01-nav.ts). The version
    tag (page-versions.hbs) moves out of the header and into the drawer at
    s only, matching the Figma frame for that breakpoint. Brand block
    renders icon-only here (title hidden) — see nav-brand.hbs's own note on
    why this isn't literally what Figma drew for m/s.
  - xs (<513): overlay drawer, full width, no scrim (it already covers the
    viewport). Its own header row replaces the brand block: product icon +
    title + a close button, all hidden at every other breakpoint.

  nav-brand.hbs and the drawer header row are both always rendered;
  side-menu.css shows exactly one per breakpoint via display, not
  server-side breakpoint logic, since this bundle emits one markup tree for
  every screen size.
--}}
<div id="side-menu" class="side-menu"{{#if page.component}} data-component="{{page.component.name}}" data-version="{{page.version}}"{{/if}}>
  <div class="side-menu__header">
    <div class="side-menu__header-start">
      {{#with site.keys.productLogo}}
      <img class="side-menu__header-logo{{#if @root.site.keys.productLogoDark}} side-menu__header-logo--light{{/if}}" src="{{{relativize this}}}" width="24" height="24" alt="">
      {{/with}}
      {{#with site.keys.productLogoDark}}
      <img class="side-menu__header-logo side-menu__header-logo--dark" src="{{{relativize this}}}" width="24" height="24" alt="">
      {{/with}}
      <span class="side-menu__header-title ids-text ids-text--title-s">{{or page.component.title site.title}}</span>
    </div>
    <button class="side-menu__close" type="button" aria-label="Close navigation">{{icon "actions" "close-large-outlined"}}</button>
  </div>
{{> nav-brand}}
  <nav class="side-menu__nav" aria-label="Site navigation">
{{> nav-menu}}
  </nav>
  <div class="side-menu__version">
{{> page-versions}}
  </div>
</div>
<div class="side-menu-scrim"></div>
