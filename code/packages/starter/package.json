{
  "name": "@inditextech/pdocs-starter",
  "version": "0.1.0",
  "private": true,
  "description": "Minimal Antora site to copy when starting a new documentation project",
  "license": "MPL-2.0",
  "engines": {
    "node": ">=24.0.0"
  },
  "scripts": {
    "build": "antora --fetch antora-playbook.yml",
    "dev": "node ../../scripts/dev.mjs build/site",
    "clean": "node -e \"require('fs').rmSync('build', { recursive: true, force: true })\""
  },
  "dependencies": {
    "@inditextech/pdocs-antora-extensions": "workspace:*",
    "@inditextech/pdocs-asciidoc-extensions": "workspace:*",
    "@inditextech/pdocs-ui-bundle": "workspace:*"
  },
  "devDependencies": {
    "antora": "~3.1.15"
  }
}
