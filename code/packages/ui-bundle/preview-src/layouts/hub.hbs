<!--
  Preview-only layout. Lives in preview-src/layouts, not src/layouts, so it is
  never packed into the published UI bundle — this is the entry page of
  `just preview-ui`, not a page any real Antora site would use.

  No site chrome (header, footer copy): this page only exists to route to the
  other preview pages. `footer-scripts` stays so `site.js` (and the theme
  toggle bootstrap it wires up) still loads.
-->
<!DOCTYPE html>
<html lang="en">
  <head>
{{> head defaultPageTitle='UI Preview'}}
    <link rel="stylesheet" href="{{{siteRootPath}}}/preview.css">
  </head>
  <body class="hub-page">
    <main class="hub">
      <ul class="hub__menu">
        <li>
          <a class="hub-card" href="home.html">
            {{icon "others" "home-outlined"}}
            <span class="hub-card__title ids-text ids-text--title-s">Home (landing) page</span>
            <span class="hub-card__desc ids-text ids-text--body-m">The `home` layout: header toolbar in its Home state, side menu collapsed by default, sticky hero column beside a grid of content blocks, site footer.</span>
          </a>
        </li>
        <li>
          <a class="hub-card" href="landing.html">
            {{icon "design" "grid-outlined"}}
            <span class="hub-card__title ids-text ids-text--title-s">Landing test page</span>
            <span class="hub-card__desc ids-text ids-text--body-m">Site chrome around a normal doc page: header, side menu, nav tree, TOC, pagination, footer — hero opted out (`-hero`) to exercise that branch.</span>
          </a>
        </li>
        <li>
          <a class="hub-card" href="content.html">
            {{icon "design" "grid-outlined"}}
            <span class="hub-card__title ids-text ids-text--title-s">Content test page</span>
            <span class="hub-card__desc ids-text ids-text--body-m">Long-form AsciiDoc kitchen sink: hero (breadcrumbs, title, excerpt, tags, actions), admonitions, tables, code blocks, collapsibles, media, footnotes.</span>
          </a>
        </li>
        <li>
          <a class="hub-card" href="404.html">
            {{icon "alerts" "warning-outlined"}}
            <span class="hub-card__title ids-text ids-text--title-s">404 page</span>
            <span class="hub-card__desc ids-text ids-text--body-m">The not-found page.</span>
          </a>
        </li>
        <li>
          <a class="hub-card" href="icons.html">
            {{icon "actions" "search-outlined"}}
            <span class="hub-card__title ids-text ids-text--title-s">Icons catalog</span>
            <span class="hub-card__desc ids-text ids-text--body-m">Every icon in the IOP Design System mirror, flagged where it is already vendored into this bundle's sprite.</span>
          </a>
        </li>
      </ul>
    </main>
{{> footer-scripts}}
  </body>
</html>
