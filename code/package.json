{
  "name": "@inditextech/docouture",
  "version": "0.1.0",
  "private": true,
  "description": "Documentation platform built on Antora",
  "repository": {
    "type": "git",
    "url": "https://github.com/InditexTech/docouture.git"
  },
  "license": "Apache-2.0",
  "packageManager": "pnpm@10.24.0",
  "engines": {
    "node": ">=24.0.0",
    "pnpm": ">=10.0.0"
  },
  "scripts": {
    "build": "nx run-many -t build",
    "lint": "nx run-many -t lint",
    "typecheck": "nx run-many -t typecheck",
    "test": "nx run-many -t test",
    "clean": "nx run-many -t clean",
    "format": "prettier --write . ../README.md",
    "format:check": "prettier --check . ../README.md",
    "verify": "nx run-many -t lint --exclude=@inditextech/docouture-example && nx run-many -t typecheck --exclude=@inditextech/docouture-example && pnpm run format:check && nx run-many -t build --exclude=@inditextech/docouture-example && nx run-many -t test --exclude=@inditextech/docouture-example",
    "version:release": "pnpm version \"$RELEASE_VERSION\" --no-git-tag-version --loglevel error && pnpm -r exec -- npm version \"$RELEASE_VERSION\" --allow-same-version --no-git-tag-version --loglevel error",
    "release:prepare": "prettier --write --log-level warn package.json 'packages/*/package.json'"
  },
  "devDependencies": {
    "@eslint/js": "~10.0.1",
    "@inditextech/docouture-tooling": "workspace:*",
    "@types/node": "~24.10.1",
    "eslint": "~10.8.1",
    "eslint-config-prettier": "~10.1.8",
    "globals": "~17.11.0",
    "nx": "~23.1.1",
    "prettier": "~3.9.6",
    "stylelint": "~17.14.1",
    "stylelint-config-standard": "~40.0.0",
    "typescript": "6.0.3",
    "typescript-eslint": "~8.67.0",
    "vitest": "~3.2.4"
  },
  "pnpm": {
    "overrides": {
      "js-yaml": "^4.3.1",
      "send": "^0.19.2"
    }
  }
}
