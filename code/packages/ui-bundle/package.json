{
  "name": "@inditextech/pdocs-ui-bundle",
  "version": "0.1.0",
  "private": true,
  "description": "Antora UI bundle for the pdocs documentation platform",
  "license": "MPL-2.0",
  "main": "index.js",
  "engines": {
    "node": ">=24.0.0"
  },
  "browserslist": [
    "last 2 versions",
    "not dead"
  ],
  "scripts": {
    "build": "gulp bundle",
    "preview": "gulp preview",
    "preview:build": "gulp preview:build",
    "typecheck": "tsc -p tsconfig.json --noEmit && tsc -p tsconfig.browser.json",
    "lint": "eslint . && stylelint \"src/css/**/*.css\"",
    "lint:fix": "eslint . --fix && stylelint \"src/css/**/*.css\" --fix",
    "clean": "gulp clean"
  },
  "devDependencies": {
    "@asciidoctor/core": "~4.0.8",
    "@inditex/sewingiopdsweb-react-components": "1.28.0",
    "@inditex/sewingiopdsweb-styles": "1.28.0",
    "@vscode/gulp-vinyl-zip": "~2.6.0",
    "autoprefixer": "~10.5.4",
    "cssnano": "~8.0.5",
    "esbuild": "~0.28.2",
    "fancy-log": "~2.0.0",
    "fs-extra": "~11.4.0",
    "gulp": "~5.0.1",
    "gulp-connect": "~5.7.0",
    "gulp-postcss": "~10.0.0",
    "handlebars": "~4.7.9",
    "highlight.js": "~11.12.0",
    "js-yaml": "~4.3.1",
    "postcss": "~8.5.26",
    "postcss-calc": "~10.1.1",
    "postcss-custom-media": "~11.0.6",
    "postcss-import": "~16.2.0",
    "postcss-mixins": "~11.0.3",
    "postcss-url": "~10.1.4",
    "require-directory": "~2.1.1",
    "require-from-string": "~2.0.2",
    "svgo": "~4.0.2",
    "typescript": "6.0.3",
    "vinyl": "~3.0.1",
    "vinyl-fs": "~4.0.2"
  }
}
