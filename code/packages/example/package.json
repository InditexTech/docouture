{
  "name": "@inditextech/docouture-example",
  "version": "1.1.1",
  "private": true,
  "description": "Real-world documentation site — target for the Fumadocs migration",
  "license": "Apache-2.0",
  "engines": {
    "node": ">=24.0.0"
  },
  "scripts": {
    "build": "antora --fetch antora-playbook.local.yml",
    "build:publish": "antora --fetch antora-playbook.yml",
    "dev": "node ../../scripts/dev.mjs build/site",
    "clean": "node -e \"require('fs').rmSync('build', { recursive: true, force: true })\""
  },
  "dependencies": {
    "@inditextech/docouture-antora-extensions": "workspace:*",
    "@inditextech/docouture-asciidoc-extensions": "workspace:*",
    "@inditextech/docouture-ui-bundle": "workspace:*"
  },
  "devDependencies": {
    "antora": "~3.2.0"
  }
}
