{{!--
  Preview-only layout (GH-66). Lives in preview-src/layouts, not src/layouts,
  so it is never packed into the published UI bundle — see icons.hbs for the
  same convention.

  Reviews the dialog's four content states — idle, loading, results, empty —
  side by side. Each card renders `.ids-modal`/`.ids-modal__container`
  directly (not the real `<dialog>`): `search-dialog.hbs` (included on every
  real page via header.hbs) already carries the outer `<dialog>` +
  `.ids-overlay`, and `.ids-overlay` is `position: fixed` to the *viewport* —
  fine for one dialog on a real page, wrong for four shown at once here,
  which would stack four full-page scrims. The panel is what actually
  differs per state, so that's what this page compares; the outer shell
  (positioning, the deliberate DS deviation in search-dialog.css, the
  backdrop) is reviewed live, per the issue's own acceptance criteria, by
  opening the real dialog from devtools on any page.

  Light/dark: this project has no in-preview theme toggle (head-prelude.hbs
  follows `prefers-color-scheme` with no override UI here) — switch with
  devtools' rendering emulation to review both.
--}}
<!DOCTYPE html>
<html lang="en">
  <head>
{{> head defaultPageTitle='Search Dialog States'}}
    <link rel="stylesheet" href="{{{siteRootPath}}}/preview.css">
  </head>
  <body class="search-dialog-page">
    <main class="search-dialog-preview">
      <a class="search-dialog-preview__back ids-text ids-text--body-m" href="{{{siteRootPath}}}/index.html">{{icon "arrows" "arrow-left-outlined"}} UI Preview</a>
      <div class="search-dialog-preview__grid">

        <section class="search-dialog-preview__card">
          <h2 class="search-dialog-preview__title ids-text ids-text--title-s">Idle</h2>
          <div class="search-dialog-preview__panel ids-modal ids-modal--small">
            <div class="ids-modal__container">
              <div class="ids-search-field-minimal ids-search-field-minimal--full-width">
                <span class="ids-search-field-minimal__icon-start" aria-hidden="true">{{icon "actions" "search-outlined"}}</span>
                <div class="ids-search-field-minimal__input-wrapper">
                  <div class="ids-search-field-minimal__input-container">
                    <input type="search" class="ids-search-field-minimal__input" placeholder="Search the docs" readonly>
                  </div>
                </div>
              </div>
              <div class="ids-modal__content ids-modal__content--scrollable"></div>
              <div class="ids-modal__footer ids-modal__footer--horizontal">
                <span class="ids-modal__footer-left ids-text ids-text--detail-m"><kbd>&uarr;&darr;</kbd> navigate &middot; <kbd>&crarr;</kbd> select &middot; <kbd>esc</kbd> close</span>
              </div>
            </div>
          </div>
        </section>

        <section class="search-dialog-preview__card">
          <h2 class="search-dialog-preview__title ids-text ids-text--title-s">Loading</h2>
          <div class="search-dialog-preview__panel ids-modal ids-modal--small">
            <div class="ids-modal__container">
              <div class="ids-search-field-minimal ids-search-field-minimal--full-width ids-search-field-minimal--has-value ids-search-field-minimal--focused">
                <span class="ids-search-field-minimal__icon-start" aria-hidden="true">{{icon "actions" "search-outlined"}}</span>
                <div class="ids-search-field-minimal__input-wrapper">
                  <div class="ids-search-field-minimal__input-container">
                    <input type="search" class="ids-search-field-minimal__input" value="weave" readonly>
                  </div>
                </div>
              </div>
              <div class="ids-modal__content ids-modal__content--scrollable">
                <div class="ids-loader" aria-hidden="true">
                  <span class="ids-loader__circle ids-loader__circle--medium"><span></span></span>
                  <span class="ids-loader__label">Loading the search index&hellip;</span>
                </div>
              </div>
              <div class="ids-modal__footer ids-modal__footer--horizontal">
                <span class="ids-modal__footer-left ids-text ids-text--detail-m"><kbd>&uarr;&darr;</kbd> navigate &middot; <kbd>&crarr;</kbd> select &middot; <kbd>esc</kbd> close</span>
              </div>
            </div>
          </div>
        </section>

        <section class="search-dialog-preview__card">
          <h2 class="search-dialog-preview__title ids-text ids-text--title-s">Results</h2>
          <div class="search-dialog-preview__panel ids-modal ids-modal--small">
            <div class="ids-modal__container">
              <div class="ids-search-field-minimal ids-search-field-minimal--full-width ids-search-field-minimal--has-value ids-search-field-minimal--focused">
                <span class="ids-search-field-minimal__icon-start" aria-hidden="true">{{icon "actions" "search-outlined"}}</span>
                <div class="ids-search-field-minimal__input-wrapper">
                  <div class="ids-search-field-minimal__input-container">
                    <input type="search" class="ids-search-field-minimal__input" value="event" readonly>
                  </div>
                </div>
              </div>
              <div class="ids-modal__content ids-modal__content--scrollable">
                <ul class="ids-list">
                  <li>
                    <a class="ids-list-item ids-list-item--clickable ids-list-item--selected" href="#">
                      <span class="ids-list-item__label">Weave.js &gt; SDK &gt; Methods &gt; <mark class="ids-highlight__mark">Events</mark></span>
                      <span class="ids-list-item__description">addEventListener &mdash; This method listens to a specific <mark class="ids-highlight__mark">event</mark> emitted by the Weave instance.</span>
                    </a>
                  </li>
                  <li>
                    <a class="ids-list-item ids-list-item--clickable" href="#">
                      <span class="ids-list-item__label">Weave.js &gt; SDK &gt; Methods &gt; <mark class="ids-highlight__mark">Events</mark></span>
                      <span class="ids-list-item__description">removeEventListener &mdash; Stops listening to a previously subscribed <mark class="ids-highlight__mark">event</mark>.</span>
                    </a>
                  </li>
                  <li>
                    <a class="ids-list-item ids-list-item--clickable" href="#">
                      <span class="ids-list-item__label">Weave.js &gt; Guides &gt; Getting started</span>
                      <span class="ids-list-item__description">Subscribing to the instance's <mark class="ids-highlight__mark">event</mark> bus from a plugin.</span>
                    </a>
                  </li>
                </ul>
              </div>
              <div class="ids-modal__footer ids-modal__footer--horizontal">
                <span class="ids-modal__footer-left ids-text ids-text--detail-m"><kbd>&uarr;&darr;</kbd> navigate &middot; <kbd>&crarr;</kbd> select &middot; <kbd>esc</kbd> close</span>
              </div>
            </div>
          </div>
        </section>

        <section class="search-dialog-preview__card">
          <h2 class="search-dialog-preview__title ids-text ids-text--title-s">Empty</h2>
          <div class="search-dialog-preview__panel ids-modal ids-modal--small">
            <div class="ids-modal__container">
              <div class="ids-search-field-minimal ids-search-field-minimal--full-width ids-search-field-minimal--has-value ids-search-field-minimal--focused">
                <span class="ids-search-field-minimal__icon-start" aria-hidden="true">{{icon "actions" "search-outlined"}}</span>
                <div class="ids-search-field-minimal__input-wrapper">
                  <div class="ids-search-field-minimal__input-container">
                    <input type="search" class="ids-search-field-minimal__input" value="xyzzy" readonly>
                  </div>
                </div>
              </div>
              <div class="ids-modal__content ids-modal__content--scrollable">
                <div class="ids-empty-state">
                  <div class="ids-empty-state__message">
                    <p class="ids-empty-state__title">No results for &ldquo;xyzzy&rdquo;</p>
                    <p class="ids-empty-state__description">Try a different search term.</p>
                  </div>
                </div>
              </div>
              <div class="ids-modal__footer ids-modal__footer--horizontal">
                <span class="ids-modal__footer-left ids-text ids-text--detail-m"><kbd>&uarr;&darr;</kbd> navigate &middot; <kbd>&crarr;</kbd> select &middot; <kbd>esc</kbd> close</span>
              </div>
            </div>
          </div>
        </section>

      </div>
    </main>
{{> footer-scripts}}
  </body>
</html>
